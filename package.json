{
  "name": "listener",
  "version": "0.10.5",
  "description": "Listener — 完全オフラインの音声入力・議事録ツール（ローカルLLM要約 + 出典リンク付き）",
  "main": "src/main.js",
  "author": "Kishi-Satoshi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "gate": "node tools/risk.js",
    "gate:staged": "node tools/risk.js --staged",
    "hedit": "node tools/hedit.js",
    "checklist": "node tools/risk.js --checklist RELEASE-CHECK.md",
    "hook": "node tools/install-hook.js"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.listener.app",
    "productName": "Listener",
    "files": [
      "src/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "asar": false,
    "compression": "maximum",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Listener-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Listener-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Listener"
    }
  }
}
